#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
image_name="${MCON_IMAGE:-mcon:local}"
container_name="${MCON_CONTAINER:-mcon}"
export MCON_DATA_DIR="${MCON_DATA_DIR:-"$repo_root/data"}"
export UV_CACHE_DIR="${UV_CACHE_DIR:-/tmp/uv-cache}"
existing_pythonpath="${PYTHONPATH:-}"
export PYTHONPATH=""

# 説明: Python import path を 1 件ずつ PYTHONPATH へ連結する。
# 引数: 第1引数は追加する path。
# 返り値: PYTHONPATH を更新し、成功時は 0。
append_python_path() {
  if [ -z "$PYTHONPATH" ]; then
    PYTHONPATH="$1"
  else
    PYTHONPATH="$PYTHONPATH:$1"
  fi
  export PYTHONPATH
}

append_python_path "$repo_root/packages/mcon/src"
append_python_path "$repo_root/packages/cli/src"
append_python_path "$repo_root/packages/tui/src"
append_python_path "$repo_root/packages/server/src"
append_python_path "$repo_root/packages/system/src"
append_python_path "$repo_root/packages/auth/src"
append_python_path "$repo_root/packages/audit/src"
append_python_path "$repo_root/packages/config/src"
append_python_path "$repo_root/packages/runtime/src"
append_python_path "$repo_root/packages/doctor/src"
append_python_path "$repo_root/packages/middleware/src"
append_python_path "$repo_root/packages/adapter/src"
if [ -n "$existing_pythonpath" ]; then
  append_python_path "$existing_pythonpath"
fi

# 説明: mcon ラッパーの利用方法を表示する。
# 引数: なし。
# 返り値: 利用方法を標準出力へ表示し、成功時は 0。
usage() {
  local lines=(
    "mcon ホストラッパー"
    ""
    "使い方:"
    "  mcon setup [--force]     ホストデータを初期化し、mcon Docker image を no-cache で作成する"
    "  mcon start               ローカル image から mcon コンテナを起動する"
    "  mcon boot [backend]      backend を選択して mcon TUI を起動する"
    "  mcon build               mcon Docker image を no-cache で作り直す"
    "  mcon stop                ホスト側 mcon server と起動中の mcon コンテナを停止する"
    "  mcon down                mcon コンテナを停止/削除し、ホスト側 server も停止する"
    "  mcon restart             ローカル image から mcon コンテナを作り直す"
    "  mcon shell               mcon コンテナ内の shell を開く"
    "  mcon logs [args...]      コンテナ log を表示する"
    "  mcon ps                  mcon コンテナの状態を表示する"
    "  mcon host [args...]      uv 経由でホスト側の mcon CLI を実行する"
    "  mcon container [args...] コンテナ内で mcon を実行する"
    "  mcon <cli args...>       コンテナ内で mcon CLI を実行する"
    ""
    "例:"
    "  mcon doctor"
    "  mcon setup"
    "  mcon start"
    "  mcon login claude --method oauth"
    "  mcon boot"
    "  mcon boot claude-code"
    "  mcon boot codex --model MODEL"
    "  mcon login nvidia --method api-key"
    "  mcon boot nvidia --model MODEL"
    "  mcon shell"
    "  mcon host doctor"
  )
  printf "%s\n" "${lines[@]}"
}

# 説明: ホスト側で mcon CLI を実行する。
# 引数: mcon CLI へそのまま渡す引数。
# 返り値: uv/python の終了コード。
host_cli() {
  cd "$repo_root"
  uv run --no-project python -m mcon.cli "$@"
}

# 説明: ホスト側 mcon CLI へ exec で置き換える。
# 引数: mcon CLI へそのまま渡す引数。
# 返り値: exec 先の終了コード。
run_host_cli() {
  cd "$repo_root"
  exec uv run --no-project python -m mcon.cli "$@"
}

# 説明: Docker image を no-cache で再構築する。
# 引数: docker build へ追加で渡す引数。
# 返り値: docker build の終了コード。
build_image() {
  cd "$repo_root"
  local previous_image_id
  local current_image_id
  previous_image_id="$(docker image inspect -f '{{.Id}}' "$image_name" 2>/dev/null || true)"
  docker build --no-cache -t "$image_name" "$repo_root" "$@"
  current_image_id="$(docker image inspect -f '{{.Id}}' "$image_name" 2>/dev/null || true)"
  remove_previous_image "$previous_image_id" "$current_image_id"
}

# 説明: setup 済み marker の path を出力する。
# 引数: なし。
# 返り値: marker path を標準出力へ表示し、成功時は 0。
setup_marker_path() {
  printf "%s\n" "$MCON_DATA_DIR/.setup-complete"
}

# 説明: 現在の MCON_IMAGE が存在するか確認する。
# 引数: なし。
# 返り値: image が存在すれば 0、存在しなければ非 0。
image_exists() {
  docker image inspect "$image_name" >/dev/null 2>&1
}

# 説明: 古い image id を削除する。
# 引数: 第1引数は旧 image id、第2引数は現 image id。
# 返り値: 削除不要または削除成功なら 0、削除失敗なら非 0。
remove_previous_image() {
  local previous_image_id="$1"
  local current_image_id="$2"
  if [ -z "$previous_image_id" ] || [ "$previous_image_id" = "$current_image_id" ]; then
    return 0
  fi
  if docker image rm --force "$previous_image_id" >/dev/null 2>&1; then
    echo "古い mcon Docker image を削除しました: ${previous_image_id#sha256:}" >&2
    return 0
  fi
  echo "警告: 古い mcon Docker image を削除できませんでした: ${previous_image_id#sha256:}" >&2
}

# 説明: 現在の MCON_CONTAINER が存在するか確認する。
# 引数: なし。
# 返り値: コンテナが存在すれば 0、存在しなければ非 0。
container_exists() {
  docker container inspect "$container_name" >/dev/null 2>&1
}

# 説明: 現在の MCON_CONTAINER が起動中か確認する。
# 引数: なし。
# 返り値: 起動中なら 0、それ以外は非 0。
container_running() {
  [ "$(docker container inspect -f '{{.State.Running}}' "$container_name" 2>/dev/null || true)" = "true" ]
}

# 説明: 既存コンテナを削除する。
# 引数: なし。
# 返り値: 削除不要または削除成功なら 0、削除失敗なら非 0。
remove_container_if_exists() {
  if container_exists; then
    docker rm -f "$container_name" >/dev/null
    echo "既存の mcon コンテナを削除しました: $container_name" >&2
  fi
}

# 説明: 起動中コンテナ内でコマンドを実行する。
# 引数: docker exec へ渡すコマンドと引数。
# 返り値: 実行コマンドの終了コード。
docker_exec() {
  if ! container_running; then
    echo "mcon コンテナは起動していません。実行してください: mcon start" >&2
    return 2
  fi
  if [ -t 0 ] && [ -t 1 ]; then
    exec docker exec -it "$container_name" "$@"
  fi
  exec docker exec "$container_name" "$@"
}

# 説明: コンテナ内 mcon CLI を実行する。
# 引数: mcon CLI へ渡す引数。
# 返り値: docker exec または mcon の終了コード。
run_container_cli() {
  docker_exec mcon "$@"
}

# 説明: mcon server コンテナを detached 起動する。
# 引数: なし。
# 返り値: docker run の終了コード。
run_container() {
  cd "$repo_root"
  mkdir -p "$MCON_DATA_DIR" "$MCON_DATA_DIR/home" "$MCON_DATA_DIR/audit" "$MCON_DATA_DIR/vault"
  if [ -f "$MCON_DATA_DIR/vault/cli-auth.env" ]; then
    set -a
    # shellcheck disable=SC1091
    . "$MCON_DATA_DIR/vault/cli-auth.env"
    set +a
  fi
  local docker_args=(
    --detach
    --name "$container_name"
    --user "$(id -u):$(id -g)"
    --env MCON_DATA_DIR=/data
  )
  local environment_name
  while IFS= read -r environment_name; do
    [ -z "$environment_name" ] && continue
    docker_args+=(--env "$environment_name=${!environment_name:-}")
  done < <(host_cli backend container-env)
  docker_args+=(--volume "$MCON_DATA_DIR:/data:rw" "$image_name")
  docker run "${docker_args[@]}"
}

# 説明: 既存コンテナを再利用しつつ server コンテナを起動する。
# 引数: なし。
# 返り値: 起動処理の終了コード。
boot_container() {
  host_cli init >/dev/null 2>&1
  if container_running; then
    echo "mcon コンテナは既に起動しています: $container_name" >&2
    return 0
  fi
  if container_exists; then
    docker start "$container_name" >/dev/null
    echo "mcon コンテナを起動しました: $container_name" >&2
    return 0
  fi
  run_container >/dev/null
  echo "mcon コンテナを起動しました: $container_name" >&2
}

case "${1:-}" in
  ""|-h|--help)
    usage
    ;;
  setup)
    shift
    force_setup=0
    setup_args=()
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --force|--rebuild)
          force_setup=1
          ;;
        *)
          setup_args+=("$1")
          ;;
      esac
      shift
    done
    host_cli init
    setup_marker="$(setup_marker_path)"
    if [ "$force_setup" -eq 0 ] && [ -f "$setup_marker" ] && image_exists; then
      echo "mcon setup は完了済みです。再実行する場合: mcon setup --force" >&2
      exit 0
    fi
    remove_container_if_exists
    build_image "${setup_args[@]}"
    date -u +"%Y-%m-%dT%H:%M:%SZ" > "$setup_marker"
    ;;
  init|serve|status|code|tui|boot|backend|list|list-paths)
    command_name="$1"
    shift
    run_host_cli "$command_name" "$@"
    ;;
  doctor)
    shift
    host_status=0
    container_status=0
    echo "ホスト側 doctor:" >&2
    host_cli doctor "$@" || host_status=$?
    if container_running; then
      echo "コンテナ側 doctor:" >&2
      if [ -t 0 ] && [ -t 1 ]; then
        docker exec -it "$container_name" mcon doctor "$@" || container_status=$?
      else
        docker exec "$container_name" mcon doctor "$@" || container_status=$?
      fi
    else
      echo "[WARN] container        起動していません。実行してください: mcon start" >&2
      container_status=1
    fi
    if [ "$host_status" -gt "$container_status" ]; then
      exit "$host_status"
    fi
    exit "$container_status"
    ;;
  build)
    shift
    build_image "$@"
    ;;
  login)
    shift
    run_host_cli login "$@"
    ;;
  start|up)
    shift
    boot_container "$@"
    ;;
  stop)
    shift
    host_cli stop || true
    if container_running; then
      docker stop "$container_name" "$@"
    else
      echo "mcon コンテナは起動していません: $container_name" >&2
    fi
    ;;
  down)
    shift
    host_cli stop || true
    if container_exists; then
      docker rm -f "$container_name" "$@"
    else
      echo "mcon コンテナは存在しません: $container_name" >&2
    fi
    ;;
  restart)
    shift
    host_cli init >/dev/null 2>&1
    if container_exists; then
      docker rm -f "$container_name" >/dev/null
    fi
    run_container >/dev/null
    echo "mcon コンテナを再起動しました: $container_name" >&2
    ;;
  shell)
    shift
    docker_exec bash "$@"
    ;;
  logs)
    shift
    exec docker logs "$@" "$container_name"
    ;;
  ps)
    shift
    exec docker ps --filter "name=^/${container_name}$" "$@"
    ;;
  container)
    shift
    run_container_cli "$@"
    ;;
  host)
    shift
    run_host_cli "$@"
    ;;
  *)
    run_container_cli "$@"
    ;;
esac
